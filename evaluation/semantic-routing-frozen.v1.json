{
  "schema_version": "semantic-routing-evaluation.v1",
  "description": "Frozen technician-language cases for atomic semantic extraction and schema-aware routing.",
  "cases": [
    { "id": "A-simple-one-fact", "template_id": "hvac-service-report", "scope_id": "HVAC", "input": "Work order is 1122344.", "expected": [{ "semantic_type": "WORK_ORDER", "value": "1122344", "field_id": "work_order" }] },
    { "id": "B-separate-sentences", "template_id": "hvac-service-report", "scope_id": "HVAC", "input": "Equipment is AC-104. Customer reported poor cooling.", "expected": [{ "semantic_type": "EQUIPMENT_OR_ASSET", "value": "AC-104", "field_id": "equipment" }, { "semantic_type": "CUSTOMER_OBSERVATION", "value": "poor cooling", "field_id": "customer_complaint" }] },
    { "id": "C-compound-sentence", "template_id": "bus-defect-rectification-corrective-maintenance", "scope_id": "SBS_BUS", "input": "I inspected the valve, replaced it, tested the system, and it passed.", "expected": [{ "semantic_type": "INSPECTION_FINDING", "value": "the valve", "field_id": "inspection_findings" }, { "semantic_type": "COMPLETED_ACTION", "value": "replaced the valve", "field_id": "work_performed" }, { "semantic_type": "PART_USED", "value": "the valve", "field_id": "parts.part_number" }, { "semantic_type": "TEST_OUTCOME", "value": "passed", "field_id": "test.result" }], "forbidden_values": ["I inspected the valve, replaced it, tested the system, and it passed"], "allow_shared_span_for": [["COMPLETED_ACTION", "PART_USED"]] },
    { "id": "D-different-order", "template_id": "hvac-service-report", "scope_id": "HVAC", "input": "Test result was passed. Work order is 1122344. I cleared the drain.", "expected": [{ "semantic_type": "TEST_OUTCOME", "value": "passed", "field_id": "test_results" }, { "semantic_type": "WORK_ORDER", "value": "1122344", "field_id": "work_order" }, { "semantic_type": "COMPLETED_ACTION", "value": "cleared the drain", "field_id": "work_performed" }] },
    { "id": "E-natural-filler", "template_id": "hvac-service-report", "scope_id": "HVAC", "input": "Okay, so I checked the unit and found the drain was blocked.", "expected": [{ "semantic_type": "INSPECTION_FINDING", "value": "the drain was blocked", "field_id": "inspection_findings" }], "forbidden_fact_types": ["TEST_ACTION"] },
    { "id": "F-customer-versus-finding", "template_id": "bus-defect-rectification-corrective-maintenance", "scope_id": "SBS_BUS", "input": "The customer reported that the front door would not close. I found a loose connector.", "expected": [{ "semantic_type": "CUSTOMER_OBSERVATION", "value": "the front door would not close", "field_id": "work.trigger" }, { "semantic_type": "INSPECTION_FINDING", "value": "a loose connector", "field_id": "inspection_findings" }] },
    { "id": "G-finding-versus-action", "template_id": "hvac-service-report", "scope_id": "HVAC", "input": "I found a blocked drain and cleared it.", "expected": [{ "semantic_type": "INSPECTION_FINDING", "value": "a blocked drain", "field_id": "inspection_findings" }, { "semantic_type": "COMPLETED_ACTION", "value": "cleared the drain", "field_id": "work_performed" }] },
    { "id": "H-part-mentioned-and-used", "template_id": "bus-defect-rectification-corrective-maintenance", "scope_id": "SBS_BUS", "input": "I installed one replacement valve.", "expected": [{ "semantic_type": "COMPLETED_ACTION", "value": "installed one replacement valve", "field_id": "work_performed" }, { "semantic_type": "PART_USED", "value": "replacement valve", "field_id": "parts.part_number" }], "allow_shared_span_for": [["COMPLETED_ACTION", "PART_USED"]] },
    { "id": "I-negated-replacement", "template_id": "bus-defect-rectification-corrective-maintenance", "scope_id": "SBS_BUS", "input": "The compressor was not replaced.", "expected": [], "forbidden_fields": ["work_performed", "parts.part_number"], "forbidden_fact_types": ["COMPLETED_ACTION", "PART_USED"] },
    { "id": "J-future-replacement", "template_id": "bus-defect-rectification-corrective-maintenance", "scope_id": "SBS_BUS", "input": "Replace the compressor next visit.", "expected": [{ "semantic_type": "RECOMMENDATION", "value": "replace the compressor next visit", "field_id": null }], "forbidden_fields": ["work_performed", "parts.part_number"], "forbidden_fact_types": ["COMPLETED_ACTION", "PART_USED"] },
    { "id": "K-test-action-only", "template_id": "bus-defect-rectification-corrective-maintenance", "scope_id": "SBS_BUS", "input": "I tested the door opening and closing.", "expected": [{ "semantic_type": "TEST_ACTION", "value": "tested the door opening and closing", "field_id": "test.result" }], "forbidden_fact_types": ["TEST_OUTCOME"] },
    { "id": "L-test-pass", "template_id": "bus-defect-rectification-corrective-maintenance", "scope_id": "SBS_BUS", "input": "I ran the door cycle test and it passed.", "expected": [{ "semantic_type": "TEST_ACTION", "value": "ran the door cycle test", "field_id": null }, { "semantic_type": "TEST_OUTCOME", "value": "passed", "field_id": "test.result" }] },
    { "id": "M-test-fail", "template_id": "bus-defect-rectification-corrective-maintenance", "scope_id": "SBS_BUS", "input": "The post-work test failed.", "expected": [{ "semantic_type": "TEST_OUTCOME", "value": "failed", "field_id": "test.result" }] },
    { "id": "N-measurement-only", "template_id": "bus-defect-rectification-corrective-maintenance", "scope_id": "SBS_BUS", "input": "Cooling pressure measured 120 psi.", "expected": [{ "semantic_type": "MEASUREMENT", "value": "120", "unit": "psi", "field_id": "measurement.pressure" }], "forbidden_fields": ["test.result"], "forbidden_fact_types": ["TEST_OUTCOME"] },
    { "id": "O-measurement-with-test-outcome", "template_id": "bus-defect-rectification-corrective-maintenance", "scope_id": "SBS_BUS", "input": "During the cooling test pressure was 120 psi and the result passed.", "expected": [{ "semantic_type": "MEASUREMENT", "value": "120", "unit": "psi", "field_id": "measurement.pressure" }, { "semantic_type": "TEST_OUTCOME", "value": "passed", "field_id": "test.result" }] },
    { "id": "P-completion-state", "template_id": "hvac-service-report", "scope_id": "HVAC", "input": "The completion status is done.", "expected": [{ "semantic_type": "COMPLETION_STATE", "value": "done", "field_id": "completion_status" }] },
    { "id": "Q-recommendation-follow-up", "template_id": "rail-track-inspection-maintenance", "scope_id": "SBS_RAIL", "input": "Recommend checking the fastener again next week.", "expected": [{ "semantic_type": "RECOMMENDATION", "value": "checking the fastener again next week", "field_id": "completion.follow_up" }], "forbidden_fields": ["work_performed"], "forbidden_fact_types": ["COMPLETED_ACTION"] },
    { "id": "R-legitimate-span-reuse", "template_id": "bus-defect-rectification-corrective-maintenance", "scope_id": "SBS_BUS", "input": "Installed replacement valve.", "expected": [{ "semantic_type": "COMPLETED_ACTION", "value": "installed replacement valve", "field_id": "work_performed" }, { "semantic_type": "PART_USED", "value": "replacement valve", "field_id": "parts.part_number" }], "allow_shared_span_for": [["COMPLETED_ACTION", "PART_USED"]] },
    { "id": "S-incompatible-reuse", "template_id": "bus-defect-rectification-corrective-maintenance", "scope_id": "SBS_BUS", "input": "I inspected the valve, replaced it and tested the system.", "expected": [{ "semantic_type": "INSPECTION_FINDING", "value": "the valve", "field_id": "inspection_findings" }, { "semantic_type": "COMPLETED_ACTION", "value": "replaced the valve", "field_id": "work_performed" }, { "semantic_type": "PART_USED", "value": "the valve", "field_id": "parts.part_number" }, { "semantic_type": "TEST_ACTION", "value": "tested the system", "field_id": "test.result" }], "forbidden_fact_types": ["TEST_OUTCOME"], "allow_shared_span_for": [["COMPLETED_ACTION", "PART_USED"]] },
    { "id": "T-multiple-captures", "template_id": "hvac-service-report", "scope_id": "HVAC", "captures": ["Work order is 1122344.", "Equipment is ABCD.", "Test result passed."], "expected": [{ "semantic_type": "WORK_ORDER", "value": "1122344", "field_id": "work_order" }, { "semantic_type": "EQUIPMENT_OR_ASSET", "value": "ABCD", "field_id": "equipment" }, { "semantic_type": "TEST_OUTCOME", "value": "passed", "field_id": "test_results" }] },
    { "id": "U-field-specific-dictation", "template_id": "hvac-service-report", "scope_id": "HVAC", "input": "Passed.", "capture_context": { "target_field_id": "test_results", "target_section_id": "Completion and handover", "capture_mode": "FIELD_DICTATION" }, "expected": [{ "semantic_type": "TEST_OUTCOME", "value": "passed", "field_id": "test_results" }] },
    { "id": "V-manual-typed-evidence", "template_id": "hvac-service-report", "scope_id": "HVAC", "input": "I cleared the blocked drain.", "input_mode": "MANUAL_TEXT", "expected": [{ "semantic_type": "COMPLETED_ACTION", "value": "cleared the blocked drain", "field_id": "work_performed" }] },
    { "id": "W-transcript-correction", "template_id": "bus-defect-rectification-corrective-maintenance", "scope_id": "SBS_BUS", "input": "Bus MAN 9-5. Replaced the door control module.", "effective_input": "Bus MAN A95. Replaced the door control module.", "expected": [{ "semantic_type": "EQUIPMENT_OR_ASSET", "value": "MAN A95", "field_id": "asset.bus_model" }, { "semantic_type": "COMPLETED_ACTION", "value": "replaced the door control module", "field_id": "work_performed" }, { "semantic_type": "PART_USED", "value": "the door control module", "field_id": "parts.part_number" }], "allow_shared_span_for": [["COMPLETED_ACTION", "PART_USED"]] },
    { "id": "X-manual-correction-supersession", "template_id": "hvac-service-report", "scope_id": "HVAC", "input": "Test result failed.", "manual_selection": { "field_id": "test_results", "value": "passed" }, "expected": [{ "semantic_type": "TEST_OUTCOME", "value": "failed", "field_id": "test_results" }] },
    { "id": "Y-missing-information", "template_id": "bus-defect-rectification-corrective-maintenance", "scope_id": "SBS_BUS", "input": "I replaced the leaking valve.", "expected": [{ "semantic_type": "COMPLETED_ACTION", "value": "replaced the leaking valve", "field_id": "work_performed" }, { "semantic_type": "PART_USED", "value": "leaking valve", "field_id": "parts.part_number" }], "forbidden_fields": ["test.result"], "forbidden_fact_types": ["TEST_OUTCOME"], "allow_shared_span_for": [["COMPLETED_ACTION", "PART_USED"]] },
    { "id": "Z-contradictory-information", "template_id": "bus-defect-rectification-corrective-maintenance", "scope_id": "SBS_BUS", "input": "The first test failed. The repeated test passed.", "expected": [{ "semantic_type": "TEST_OUTCOME", "value": "failed", "field_id": "test.result" }, { "semantic_type": "TEST_OUTCOME", "value": "passed", "field_id": "test.result" }], "expected_field_state": { "field_id": "test.result", "state": "CONFLICT" } }
  ]
}
