# Local-only mode is the safe default. `npm start` needs no environment file.
HVAC_HOST=127.0.0.1
HVAC_PORT=4310

# For `npm run demo`, set a fresh 16+ character token in the shell.
# Never commit a real token. This placeholder is intentionally unusable.
HVAC_DEMO_TOKEN=CHANGE_ME

# Optional exact hostnames for a trusted LAN; private LAN IPs work without this.
# HVAC_ALLOWED_HOSTS=demo-mac.local

# Optional server-controlled local model. The browser cannot select it.
# HVAC_OLLAMA_MODEL=qwen-model-already-installed-locally
