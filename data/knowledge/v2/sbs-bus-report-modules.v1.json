{
  "schema_version": "sbs-bus-report-modules.v1",
  "knowledge_version": "2026-09-24",
  "scope": "SBS_BUS",
  "fixed_sections": [
    {
      "id": "vehicle_identification",
      "title": "车辆识别",
      "fields": ["asset.registration_no", "asset.model", "asset.odometer", "asset.depot", "asset.package", "asset.route_service"],
      "tag": "CONFIRMED BY EVIDENCE",
      "evidence": {
        "evidence_level": "B",
        "confidence": "HIGH",
        "basis": ["LTA OneMotoring — Bus registration（VRN, B）", "SBS Transit AR2024（车厂/配套, A）"],
        "notes": "身份来源为 B/A；内部车队编号 REQUIRES SBS CONFIRMATION。"
      }
    },
    {
      "id": "works_summary",
      "title": "作业摘要",
      "fields": ["work.type", "work.date", "work.work_order_id", "work.trigger"],
      "tag": "PROVISIONAL",
      "evidence": {
        "evidence_level": "A",
        "confidence": "MEDIUM",
        "basis": ["SBS Transit AR2024（工作流存在, A）", "LTA OneMotoring（触发类型, B）"],
        "notes": "工单号格式 REQUIRES SBS CONFIRMATION。"
      }
    },
    {
      "id": "inspection_findings",
      "title": "检查发现",
      "fields": ["inspection_findings", "work.fault_code"],
      "tag": "CONFIRMED BY EVIDENCE",
      "evidence": {
        "evidence_level": "B",
        "confidence": "HIGH",
        "basis": ["LTA OneMotoring 检查类别（B）"],
        "notes": "法定检查类别为 B；故障码表 REQUIRES SBS CONFIRMATION。"
      }
    },
    {
      "id": "diagnosis",
      "title": "诊断与根因",
      "fields": ["diagnosis", "diagnosis.root_cause"],
      "tag": "PROVISIONAL",
      "evidence": {
        "evidence_level": "C",
        "confidence": "LOW",
        "basis": ["ISO 14224 维护数据模型（C）"],
        "notes": "根因字段模型为可比行业（C）；SBS 诊断流程未公开。"
      }
    },
    {
      "id": "work_performed",
      "title": "完成工作",
      "fields": ["work_performed", "work.work_instructions_ref"],
      "tag": "CONFIRMED BY EVIDENCE",
      "evidence": {
        "evidence_level": "A",
        "confidence": "HIGH",
        "basis": ["SBS Transit Green Efforts（平板工作指示, A）"],
        "notes": "动作只能来自转写/技师输入，绝不由知识填充（V1 不变量）。"
      }
    },
    {
      "id": "parts_used",
      "title": "使用或更换的零件与材料",
      "fields": ["parts_used", "parts.part_number", "parts.quantity"],
      "tag": "PROVISIONAL",
      "evidence": {
        "evidence_level": "A",
        "confidence": "MEDIUM",
        "basis": ["SBS Transit Green Efforts（零件信息访问, A）"],
        "notes": "零件号方案 REQUIRES SBS CONFIRMATION。"
      }
    },
    {
      "id": "test_results",
      "title": "测试与结果",
      "fields": ["test_results", "test.brake_efficiency", "test.emissions", "test.electrical"],
      "tag": "CONFIRMED BY EVIDENCE",
      "evidence": {
        "evidence_level": "B",
        "confidence": "HIGH",
        "basis": ["LTA OneMotoring（制动效率/排放/噪声检查, B）"],
        "notes": "法定测试类别为 B；通过阈值 NOT PUBLICLY VERIFIED，不得编造。"
      }
    },
    {
      "id": "completion_status",
      "title": "完成状态",
      "fields": ["completion_status", "completion.state", "completion.return_to_service"],
      "tag": "PROVISIONAL",
      "evidence": {
        "evidence_level": "C",
        "confidence": "LOW",
        "basis": ["可比 CMMS 工单生命周期（C）", "14 CFR 43.9（C）"],
        "notes": "SBS 状态词表与回役标准 REQUIRES SBS CONFIRMATION。"
      }
    },
    {
      "id": "safety_hv_notes",
      "title": "安全与 HV 备注",
      "fields": ["safety.hv_isolation", "safety.ness_cert", "safety.safety_device_findings"],
      "tag": "CONFIRMED BY EVIDENCE",
      "evidence": {
        "evidence_level": "A",
        "confidence": "HIGH",
        "basis": ["SBS Transit AR2024（NESS 认证, A）", "WSHC 车辆风险因素（B）"],
        "notes": "项目存在为 A/B；程序文本 NOT PUBLICLY VERIFIED。"
      }
    },
    {
      "id": "compliance_audit",
      "title": "合规与审计",
      "fields": ["compliance.inspection_due_date", "compliance.licence_package_refs", "compliance.lta_standards"],
      "tag": "CONFIRMED BY EVIDENCE",
      "evidence": {
        "evidence_level": "B",
        "confidence": "HIGH",
        "basis": ["LTA OneMotoring（检验义务, B）", "SBS AR2022（符合 LTA 维护标准, A）"],
        "notes": "义务存在为 A/B；记录格式 NOT PUBLICLY VERIFIED。"
      }
    },
    {
      "id": "provenance",
      "title": "溯源",
      "fields": ["provenance.transcript", "provenance.uploads", "provenance.knowledge_versions"],
      "tag": "CONFIRMED BY EVIDENCE",
      "evidence": {
        "evidence_level": "A",
        "confidence": "HIGH",
        "basis": ["V1 事实收据（A, 仓库基线）"],
        "notes": "溯源为 V1 既有机制（A）。"
      }
    }
  ],
  "conditional_sections": [
    {
