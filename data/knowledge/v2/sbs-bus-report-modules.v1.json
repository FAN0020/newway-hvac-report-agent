    {
      "id": "warranty",
      "title": "保修情况",
      "fields": ["warranty"],
      "tag": "MANUAL_OR_AUTHORIZED_ONLY",
      "manual_or_authorized_only": true,
      "evidence": {
        "evidence_level": "D",
        "confidence": "HIGH",
        "basis": ["V1 手动字段惯例（A, 仓库基线）", "05 §5（D）"],
