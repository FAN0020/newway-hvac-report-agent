      "kind": "unit",
      "canonical": "bus-km",
      "aliases": ["车公里", "巴士公里", "bus-kilometre", "bus-kilometer"],
      "context": "安全指标（每 10 万 bus-km 事故数）、BCM QoS 计划里程",
      "normalization_rules": [
