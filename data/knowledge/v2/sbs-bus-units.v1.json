  "scope": "SBS_BUS",
  "records": [
    {
      "id": "unit_km",
      "kind": "unit",
      "canonical": "km",
      "aliases": ["公里", "千米", "kilometre", "kilometer"],
      "context": "里程表（odometer）、里程/时间触发的定期维护、bus-km 统计",
      "normalization_rules": [
        {
          "source_unit": "km",
          "target_unit": "m",
          "factor": 1000,
          "notes": "1 km = 1000 m（公制定义）"
        }
      ],
      "evidence": {
        "evidence_level": "A",
        "confidence": "HIGH",
        "basis": ["SBS Transit AR2024 Operations Review（bus-km 指标）", "LTA OneMotoring"],
        "notes": "km/bus-km 出现在 SBS/LTA 公开材料中（A/B）。"
      }
    },
    {
      "id": "unit_percent",
      "kind": "unit",
      "canonical": "%",
      "aliases": ["百分比", "percent", "百分之"],
      "context": "制动效率、排放水平、QoS 完成率（≥96% 计划里程）、事故率等",
      "normalization_rules": [
        {
          "source_unit": "%",
          "target_unit": "fraction",
          "factor": 0.01,
          "notes": "百分比与小数互为转换（公制定义）"
        }
      ],
      "evidence": {
        "evidence_level": "B",
        "confidence": "HIGH",
        "basis": ["LTA OneMotoring（制动效率/排放检查）", "LTA BCM（QoS ≥96%）", "SBS AR2024（0.142/100k bus-km）"],
        "notes": "% 出现在新加坡交通部门与 SBS 公开材料中（A/B）。具体阈值未公开，仅单位定义。"
      }
    },
